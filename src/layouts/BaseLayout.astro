---
import '../styles/global.css';
const { title = 'Home Assistantで、やりたいことを探す。', description = 'Home Assistantで実現できる暮らしのアイデア集。' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | HAでできること</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={baseUrl}>HAでできること<span>Home Assistant Use Cases</span></a>
      <nav><a href={baseUrl}>事例を探す</a><a href="https://www.home-assistant.io/" target="_blank" rel="noreferrer">Home Assistant公式</a></nav>
    </header>
    <main><slot /></main>
    <footer>
      Home Assistantで、こんなことができる。 <span>アイデア共有カタログ</span>
      <div class="ai-credit">Made with ChatGPT</div>
    </footer>
  </body>
</html>
