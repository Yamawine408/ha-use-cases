---
import '../styles/global.css';
const { title = 'Home Assistant で、やりたいことを探す。', description = 'Home Assistant で実現できる暮らしのアイデア集。' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | HAでできること</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={baseUrl}>HAnumans トップページ</a>
      <nav><a href="https://www.home-assistant.io/" target="_blank" rel="noreferrer">Home Assistant 公式</a></nav>
    </header>
    <main><slot /></main>
    <footer>
      <hr>
      <div class="legal-note">このサイトに掲載している一部のデバイスは、日本国内での使用や設置に法律上の制限がある場合があります。使用・設置の前に、関連する法令や規制をご確認ください。</div>
      <div class="ai-credit">Made with ChatGPT</div>
    </footer>
  </body>
</html>
