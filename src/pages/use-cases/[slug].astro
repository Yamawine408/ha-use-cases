---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

export async function getStaticPaths() {
  const entries = await getCollection('useCases', ({ data }) => !data.isTemplate);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="detail">
    <a class="back" href={baseUrl + 'cases/'}>← 事例一覧に戻る</a>
    <span class="category">{entry.data.category}</span>
    <h1>{entry.data.title}</h1>
    <p class="detail-summary">{entry.data.summary}</p>
    {entry.data.difficulty ? <p class="difficulty">目安：{entry.data.difficulty}</p> : null}
    {entry.data.tags.length ? <div class="tags">{entry.data.tags.map((tag) => <span>#{tag}</span>)}</div> : null}
    {entry.data.requirements.length ? <section>
      <h2>必要なもの・関連するもの</h2>
      <ul>{entry.data.requirements.map((requirement) => <li>{requirement}</li>)}</ul>
    </section> : null}
    <div class="case-content">
      <Content />
    </div>
    {entry.data.references.length ? <section>
      <h2>参考リンク</h2>
      <ul>{entry.data.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noreferrer">{reference.label} ↗</a></li>)}</ul>
    </section> : null}
  </article>
</BaseLayout>
<style>
  .case-content{line-height:1.85}
  .case-content h2{margin:2.2rem 0 .9rem;padding-bottom:.55rem;border-bottom:1px solid var(--border,rgba(128,128,128,.2))}
  .case-content h3{margin:1.6rem 0 .65rem}
  .case-content p,.case-content li{line-height:1.85}
  .case-content ul,.case-content ol{padding-left:1.35rem}
  .case-content img{max-width:100%;height:auto;border-radius:12px}
  .case-content table{display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}
  .case-content th,.case-content td{padding:.55rem .8rem;border:1px solid var(--border,rgba(128,128,128,.2))}
  .case-content pre{max-width:100%;overflow-x:auto;padding:1rem;border-radius:12px;background:var(--card,rgba(128,128,128,.07))}
  .case-content details{margin:1rem 0;padding:.75rem 1rem;border:1px solid var(--border,rgba(128,128,128,.2));border-radius:12px}
</style>
