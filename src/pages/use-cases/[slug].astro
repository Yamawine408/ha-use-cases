---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';

export async function getStaticPaths() {
  const entries = await getCollection('useCases');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="detail">
    <a class="back" href={baseUrl}>← 事例一覧に戻る</a>
    <span class="category">{entry.data.category}</span>
    <h1>{entry.data.title}</h1>
    <p class="detail-summary">{entry.data.summary}</p>
    {entry.data.difficulty && <p class="difficulty">目安：{entry.data.difficulty}</p>}
    {entry.data.tags.length > 0 && (
      <div class="tags">{entry.data.tags.map((tag) => <span>#{tag}</span>)</div>
    )}
    {entry.data.requirements.length > 0 && (
      <section>
        <h2>必要なもの・関連するもの</h2>
        <ul>{entry.data.requirements.map((requirement) => <li>{requirement}</li>)}</ul>
      </section>
    )}
    <section class="idea-note">
      <h2>実現のヒント</h2>
      <p>センサーやデバイスの状態をHome Assistantで組み合わせることで実現できます。具体的な構成は環境によって異なります。下の参考リンクもご覧ください。</p>
    </section>
    {entry.data.references.length > 0 && (
      <section>
        <h2>参考リンク</h2>
        <ul>
          {entry.data.references.map((reference) => (
            <li><a href={reference.url} target="_blank" rel="noreferrer">{reference.label} ↗</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
