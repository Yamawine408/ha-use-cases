---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const cases = await getCollection('useCases');
const categories = [...new Set(cases.map((c) => c.data.category))].sort();
---
<BaseLayout>
  <section class="hero">
    <h2>Home Assistant の「沼」へようこそ！</h2>
    <p class="hero-copy">Home Assistant で「こんなことできる？」の答えを見つけましょう。
    Home Assistant の沼にハマった人々のアイデアを元に日々の暮らしをもっと便利にしよう！</p>
  </section>
  <section class="intro-links" aria-label="Home Assistant が初めての方へ">
    <div class="idea-hub-head">
      <h3>Home Assistant (HA) が初めての方へ</h3>
    </div>
    <div class="idea-grid">
        <a class="idea-card" href={baseUrl + 'about/'}>
    	  <h4>Home Assistant (HA) とは？</h4>
        </a>  	   
        <a class="idea-card" href={baseUrl + 'getting-started/'}>
          <h4>Home Assistant (HA) を始めよう</h4>
        </a>
    </div>
  </section>
  <section class="idea-hub" aria-label="アイデアを探す">
    <div class="idea-hub-head">
      <h3>アイデアを探す</h3>
      <p>きっかけや目的から、Home Assistantでできることを見つけよう。</p>
    </div>
    <div class="idea-grid">
      <a class="idea-card" href={baseUrl + 'triggers/'}>
        <h4>何かが起きたら</h4>
        <p>人の検知、温度変化、帰宅、時刻、天気など。きっかけから探す。</p>
      </a>
      <a class="idea-card" href={baseUrl + 'actions/'}>
        <h4>こういうことをしたい</h4>
        <p>照明を点ける、家電を動かす、通知する。目的から探す。</p>
      </a>
      <a class="idea-card idea-card-featured" href={baseUrl + 'cases/'}>
        <h4>事例集</h4>
        <p>具体的な活用例を眺めながら、新しいアイデアを見つける。</p>
      </a>
    </div>
  </section>
  <section class="idea-hub" aria-label="技術解説">
    <div class="idea-hub-head">
      <h3>技術の解説</h3>
    </div>
    <div class="idea-grid">
      <a class="idea-card" href={baseUrl + 'devices/'}>
        <h4>HAデバイス</h4>
        <p>HAで使われるデバイス（センサー、赤外線、エアコン、カーテンなど）</p>
      </a>
      <a class="idea-card" href={baseUrl + 'network/'}>
        <h4>ネットワーク・通信・連携技術</h4>
        <p>Wi-Fi、Zigbee、MQTT、ZHAなど、機器をつなぐ技術を知る。</p>
      </a>
      <a class="idea-card" href={baseUrl + 'integratios/'}>
        <h4>役にたつインテグレーション</h4>
        <p>HAの機能を拡充するインテグレーションの紹介</p>
      </a>
      <a class="idea-card" href={baseUrl + 'apps/'}>
        <h4>役にたつApp</h4>
        <p>HAの機能を拡充するAppの紹介</p>
      </a>
      <a class="idea-card" href={baseUrl + 'tips/'}>
        <h4>HA テクニック</h4>
        <p>HAのちょっとしたテクニック</p>
      </a>
      <a class="idea-card" href={baseUrl + 'trouble-shooting/'}>
        <h4>トラブルシューティング</h4>
        <p>トラブル解決のヒント</p>
      </a>
    </div>
  </section>
</BaseLayout>