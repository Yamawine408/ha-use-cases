---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const cases = await getCollection('useCases');
const categories = [...new Set(cases.map((c) => c.data.category))].sort();
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">HOME ASSISTANT USE CASES</p>
    <h1>Home Assistant の「沼」へようこそ！</h1>
    <p class="hero-copy">Home Assistant で「こんなことできる？」から始めよう。暮らしの中のアイデアを見つける事例集です。</p>
  </section>
  <section class="intro-links" aria-label="初めての方へ">
    <a class="intro-card" href={baseUrl + 'about/'}>
      <h2>HAってなに？</h2>
      <p>Home Assistantでできること、スマートホームの楽しさを知る。</p>
      <span class="intro-more">読む →</span>
    </a>
    <a class="intro-card" href={baseUrl + 'getting-started/'}>
      <span class="intro-icon">⚙</span>
      <span class="intro-label">START GUIDE</span>
      <h2>HAを始めるために必要なこと</h2>
      <p>導入に必要な機器や環境、最初の一歩を知る。</p>
      <span class="intro-more">読む →</span>
    </a>
  </section>
  <section class="idea-hub" aria-label="アイデアを探す">
    <div class="idea-hub-head">
      <p class="eyebrow">EXPLORE IDEAS</p>
      <h2>アイデアを探す</h2>
      <p>きっかけや目的から、Home Assistantでできることを見つけよう。</p>
    </div>
    <div class="idea-grid">
      <a class="idea-card" href={baseUrl + 'triggers/'}>
        <span class="idea-number">01</span>
        <h3>何かが起きたら</h3>
        <p>人の検知、温度変化、帰宅、時刻、天気など。きっかけから探す。</p>
        <span class="idea-arrow">探す →</span>
      </a>
      <a class="idea-card" href={baseUrl + 'actions/'}>
        <span class="idea-number">02</span>
        <h3>こういうことをしたい</h3>
        <p>照明を点ける、家電を動かす、通知する。目的から探す。</p>
        <span class="idea-arrow">探す →</span>
      </a>
      <a class="idea-card idea-card-featured" href={baseUrl + 'cases/'}>
        <span class="idea-number">03</span>
        <h3>事例集</h3>
        <p>具体的な活用例を眺めながら、新しいアイデアを見つける。</p>
        <span class="idea-arrow">事例を見る →</span>
      </a>
      <a class="idea-card" href={baseUrl + 'devices/'}>
        <span class="idea-number">04</span>
        <h3>デバイス解説</h3>
        <p>センサーや機器の仕組み、特徴、選び方を知る。</p>
        <span class="idea-arrow">知る →</span>
      </a>
      <a class="idea-card" href={baseUrl + 'network/'}>
        <span class="idea-number">05</span>
        <h3>ネットワーク・通信・連携技術</h3>
        <p>Wi-Fi、Zigbee、MQTT、ZHAなど、機器をつなぐ技術を知る。</p>
        <span class="idea-arrow">知る →</span>
      </a>
    </div>
  </section>
  <section class="catalog catalog-link" id="cases">
    <a class="catalog-link-card" href={baseUrl + 'cases/'}>
      <div class="catalog-head"><h2>事例集・プレビュー</h2><span>{cases.length}件 →</span></div>
      <p>実際の活用事例を一覧で見て、Home Assistantでできることを探してみよう。</p>
      <span class="read-more">事例一覧を見る →</span>
    </a>
  </section>
</BaseLayout>